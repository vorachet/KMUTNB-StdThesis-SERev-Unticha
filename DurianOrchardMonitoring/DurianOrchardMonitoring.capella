          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="9f887b1d-9d98-47e6-8c74-f77014bc51ce" name="คำนวณเวลาออกอากาศ" appliedPropertyValueGroups="#b96a58d0-90fa-4d67-b70e-e79b06b6312f">
            <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
                id="a6fc67dd-5413-47ff-b3fb-8f172d7e0ae9" name="เวลาออกอากาศ_s = ขนาดข้อมูล_bytes * 8 / (ตัวแผ่สเปกตรัม_sf * แบนด์วิดท์_hz / 2^ตัวแผ่สเปกตรัม_sf)"
                summary="technique" description="เวลาออกอากาศตามที่ GUI สมการ 3-3 ถึง 3-5 คำนวณสำหรับการทดสอบเสาอากาศ: อัตราสัญลักษณ์ BW / 2^SF = 30.5175 สัญลักษณ์ต่อวินาที อัตราบิต SF x อัตราสัญลักษณ์ = 366.211 บิตต่อวินาที เวลา = 8 x ขนาดข้อมูล / อัตราบิต = 0.3495 วินาที สำหรับ 16 ไบต์ที่ SF 12 และ 125 kHz"
                constrainedElements="#9f887b1d-9d98-47e6-8c74-f77014bc51ce #079cf2d9-336c-48e1-930d-cc097c4a6222">
              <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
                  id="c2e86d11-4a3e-49e8-bfd9-e09835503b0e">
                <bodies>เวลาออกอากาศ_s = ขนาดข้อมูล_bytes * 8 / (ตัวแผ่สเปกตรัม_sf * แบนด์วิดท์_hz / 2^ตัวแผ่สเปกตรัม_sf)</bodies>
                <languages>NORASI</languages>
              </ownedSpecification>
            </ownedConstraints>
            <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                id="b96a58d0-90fa-4d67-b70e-e79b06b6312f" name="NORASI.Function">
              <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:IntegerPropertyValue"
                  id="843c70da-f9d1-4ddf-8836-eae1968766c8" name="ตัวแผ่สเปกตรัม_sf"
                  value="12"/>
              <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:IntegerPropertyValue"
                  id="0a380cbf-34de-480f-bec8-45e2917c79fc" name="แบนด์วิดท์_hz" value="125000"/>
              <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:IntegerPropertyValue"
                  id="9e118825-405b-4dbd-8010-06bfbd2e0838" name="ขนาดข้อมูล_bytes"
                  value="16"/>
            </ownedPropertyValueGroups>
            <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                id="710eb081-30d1-45fe-8378-b70417a057fe" name="คำนวณเวลาออกอากาศ_In"/>
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="df0d2d8c-4b7b-4ae5-96eb-1a1fb4015152" name="คำนวณเวลาออกอากาศ_Out"/>
            <ownedFunctionRealizations xsi:type="org.polarsys.capella.core.data.fa:FunctionRealization"
                id="366bf964-d7e1-450d-8181-e1d098a71551" targetElement="#2abbe732-a23d-42d4-8367-ecf4554ed472"
                sourceElement="#9f887b1d-9d98-47e6-8c74-f77014bc51ce"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="08b6d2b8-c724-4019-af24-c87a7a05e14c" name="ประมาณกำลังที่รับได้"
              appliedPropertyValueGroups="#27e1c6f3-9426-4129-bb3a-68a2dd06a51b">
            <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
                id="72c4f4fb-de18-49d9-9310-8e52688b36ec" name="กำลังรับ_dbm = กำลังส่ง_dbm + อัตราขยายเสาส่ง_dbi + อัตราขยายเสารับ_dbi - (20 * log10(ระยะทาง_km) + 20 * log10(ความถี่_mhz) + 32.44) - การสูญเสียในสาย_db"
                summary="technique" description="งบการเชื่อมโยงตามที่ GUI สมการ 3-1 และ 3-2 เขียนไว้ P_r = P_t + G_t + G_r - L_p - L_c โดยการสูญเสียในที่ว่าง L_p = 20 log10 d + 20 log10 f + 20 log10(4 pi / c) ซึ่งเท่ากับ 77.2 dB ที่ 0.4 km และ 433 MHz (32.44 คือพจน์สุดท้ายเมื่อ d เป็น km และ f เป็น MHz) นับอัตราขยาย 5 dBi แต่ละตัวเพียงครั้งเดียว"
                constrainedElements="#08b6d2b8-c724-4019-af24-c87a7a05e14c #592272af-e9d3-4c51-92f4-881cb745ea77">
              <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
                  id="e0f73565-1e54-4af2-99db-c0c6c967eaa3">
                <bodies>กำลังรับ_dbm = กำลังส่ง_dbm + อัตราขยายเสาส่ง_dbi + อัตราขยายเสารับ_dbi - (20 * log10(ระยะทาง_km) + 20 * log10(ความถี่_mhz) + 32.44) - การสูญเสียในสาย_db</bodies>
                <languages>NORASI</languages>
              </ownedSpecification>
