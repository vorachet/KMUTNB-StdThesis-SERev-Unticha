          <ownedFunctionalChains xsi:type="org.polarsys.capella.core.data.fa:FunctionalChain"
              id="42b1c230-69d4-4aa3-b689-5f9fab177420" name="DP-15_LINE_Notify_เป็นช่องทางเดียว_การนำไปปฏิบัติ"
              appliedPropertyValueGroups="#5093b225-206a-4972-a487-b8f29417a55e">
            <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
                id="3e0d4ebe-6676-486e-b96b-50469d29241b" name="จำนวนข้อความ_LINE_ต่อเดือน"
                description="ต้นทุน. MOP สำหรับคำถาม PA: รายงานของ Apps Script ทุก 4 ชั่วโมง (วิทยานิพนธ์ F-10 อ้างอิง Nunthasrithananon et al., 2024, pp. 66, 146) ตลอด 30 วัน เทียบกับ 300 ข้อความต่อเดือนที่ LINE Messaging API ให้ใช้ (วิทยานิพนธ์ F-10) การเตือนส่งผ่าน LINE Notify ซึ่งยุติการให้บริการเมื่อ 31 มีนาคม 2025 (ประเด็น F-09) จึงไม่นับข้อความเตือน. หมวดการศึกษา: REV-OBJ-2_ต้นทุนทางเศรษฐศาสตร์"
                appliedPropertyValueGroups="#96712c25-992e-43ec-86e4-b0f90d4f2e67"
                constrainedElements="#42b1c230-69d4-4aa3-b689-5f9fab177420">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="96712c25-992e-43ec-86e4-b0f90d4f2e67" name="NORASI.Constraint">
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue"
                    id="a2f0d7a3-1b9a-4077-8883-7f9ce1a25df3" name="name" value="จำนวนข้อความ_LINE_ต่อเดือน"/>
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:FloatPropertyValue"
                    id="dc767b21-da58-4bc4-9639-f34b91082846" name="min"/>
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:FloatPropertyValue"
                    id="4e2ecf33-d450-4142-a438-60b3b97e059c" name="max" value="300.0"/>
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                    id="8a02abc9-1553-43a3-9cde-c746a76ded3a" name="objective" type="#d185c385-6cda-4648-a4c6-063cf0d25b52"
                    value="#0f64f746-f721-4c1f-92cf-5afe25c4f2f4"/>
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                    id="cc08122e-58bd-4639-86fb-36e8ddc2b392" name="type" type="#f91a7032-2808-4ccf-b80a-97ad3360518d"
                    value="#dd3cd600-c3e0-40e5-9c87-ca1e8c85d365"/>
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue"
                    id="fadf49fa-e5cb-4bc1-8be4-47999e76fb57" name="refines" value="ข้อความที่ต้องใช้ต่อเดือน"/>
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue"
                    id="ad858bf4-2daf-4a80-b5a6-6aaf4032c92d" name="raci" value="accountable เกษตรกรชาวสวนทุเรียน; responsible นักบำรุงรักษา; consulted คนงานในสวน when BEFORE_CHANGE by MEETING; informed เกษตรกรชาวสวนทุเรียน when ON_BREACH by MESSAGE"/>
              </ownedPropertyValueGroups>
