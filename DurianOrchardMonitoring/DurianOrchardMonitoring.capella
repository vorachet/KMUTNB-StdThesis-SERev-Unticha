        <ownedOperationalActivities xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
            id="f02801bf-fe58-4ca9-9d65-5499ac54f8d3" name="Root Operational Activity">
          <ownedFunctionalChains xsi:type="org.polarsys.capella.core.data.oa:OperationalProcess"
              id="faa8aef3-7935-4694-b79e-61d320723d9a" name="UR-01_สวนที่เฝ้าดูและตัดสินใจได้จากที่ไกล"
              appliedPropertyValueGroups="#1663261d-0a77-4751-a299-0d8b6ee80534">
            <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
                id="a0a69702-0386-48aa-bd5a-611c8c373b62" name="สวนถูกเฝ้าดูจากที่ไกล"
                description="ภารกิจ. MoE สำหรับคำถาม OA: ในสวนทุเรียนของจังหวัดนนทบุรีที่ตั้งเสาไว้ ห่างจากเกตเวย์ 10 ถึง 60 เมตร (GUIS สไลด์ 141-151) ขณะที่โครงงานทั้งสองสัญญาระยะ 400 เมตร (GUIS สไลด์ 7-8) สวนเป็นที่รู้จากที่ไกลได้ดีเพียงใด จนเกษตรกรตัดสินใจเรื่องน้ำและปุ๋ยได้โดยไม่ต้องเดินตามแถว: สวนที่เกษตรกรต้องการ UN1 ของวิทยานิพนธ์? ต้องการจากระบบ สัดส่วนค่าวัดที่ส่งถึงที่ระยะ_400_m_pct [96 .. 100] จาก SR-01_ส่งค่าวัดได้จากระยะ_400_เมตร วันนี้: ได้ตามต้องการบางส่วน -- ค่าวัดมาถึง แต่เกษตรกรถอดปลั๊กเกตเวย์เป็นบางครั้ง (GUIS สไลด์ 138; ประเด็น F-17)."
                appliedPropertyValueGroups="#afa25151-e830-46b1-958f-227aba5fff28"
                constrainedElements="#faa8aef3-7935-4694-b79e-61d320723d9a">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="afa25151-e830-46b1-958f-227aba5fff28" name="NORASI.Constraint">
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue"
                    id="6365ec97-6be8-4a36-a8d5-a3931d2a6327" name="name" value="สวนถูกเฝ้าดูจากที่ไกล"/>
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:FloatPropertyValue"
                    id="489b0e6a-18f8-4b46-9797-e6caa7a6155c" name="min" value="3.0"/>
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:FloatPropertyValue"
                    id="b7d89498-a40e-4b5c-ad10-8baa252c13b2" name="max" value="3.0"/>
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                    id="e01a176d-d5de-4b48-9b48-789e962d035b" name="objective" type="#e2384934-8a18-4a0a-a5c1-7bebadca8279"
                    value="#cf25501b-4a62-4536-a038-c39193741bed"/>
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
                    id="d9a3174e-3845-4d87-94d5-b866e686322b" name="type" type="#cb8cac97-a6e4-41cd-a3a4-dc7640bc339b"
