          <ownedFunctionalChains xsi:type="org.polarsys.capella.core.data.oa:OperationalProcess"
              id="fe2490b8-1106-4e51-9388-b5d38f577d4f" name="UR-04_สวนที่เฝ้าดูได้ในงบของเกษตรกรรายย่อย"
              appliedPropertyValueGroups="#d5029244-1904-443e-aa04-4a06390e8da1">
            <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
                id="686d7fe2-8f5f-4325-a04f-b4a5db97062c" name="การเฝ้าดูอยู่ในงบที่จ่ายไหว"
                description="ภารกิจ. MoE สำหรับคำถาม OA: สวนถูกเฝ้าดูต่อเนื่องทุกฤดูด้วยงบที่ไร่ขนาดเล็กจ่ายไหวได้ดีเพียงใด: สวนที่เกษตรกรต้องการ UN4 ของวิทยานิพนธ์? ต้องการจากระบบ สัดส่วนค่าวัดที่ส่งถึงที่ระยะ_400_m_pct [96 .. 100] จาก SR-01_ส่งค่าวัดได้จากระยะ_400_เมตร, ชั่วโมงที่ขาดจากหนึ่งวันของแบตเตอรี่_h [0 .. 0] จาก SR-04_จ่ายพลังงานให้ตัวเองทั้งกลางวันและกลางคืน และ สัดส่วนเวลาทำงานของเซิร์ฟเวอร์_pct [100 .. 100] จาก SR-08_บันทึกตลอดเวลาอย่างปลอดภัย วันนี้: ได้ตามต้องการบางส่วน -- เซิร์ฟเวอร์ล่ม 5 วันจาก 105 วัน (GUIS สไลด์ 35) และโครงงาน GUI เสนอให้ย้ายเซิร์ฟเวอร์ (GUIS สไลด์ 138)."
                appliedPropertyValueGroups="#1f09e1c7-13f4-49af-a3cc-0b12d8ec8fe7"
                constrainedElements="#fe2490b8-1106-4e51-9388-b5d38f577d4f">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="1f09e1c7-13f4-49af-a3cc-0b12d8ec8fe7" name="NORASI.Constraint">
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue"
                    id="afe58c55-e9c0-454e-a3fd-5b6bc85d1c61" name="name" value="การเฝ้าดูอยู่ในงบที่จ่ายไหว"/>
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:FloatPropertyValue"
