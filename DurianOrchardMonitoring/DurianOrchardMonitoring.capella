                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue"
                    id="bbdab900-5279-4e6a-b1eb-79eacd2b3a36" name="raci" value="accountable เกษตรกรชาวสวนทุเรียน; responsible นักบำรุงรักษา; consulted คนงานในสวน when BEFORE_CHANGE by MEETING; informed เกษตรกรชาวสวนทุเรียน when ON_BREACH by MESSAGE"/>
              </ownedPropertyValueGroups>
