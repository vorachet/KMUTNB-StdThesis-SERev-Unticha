                    id="511a316f-e02a-441b-8591-2348208a5889" name="name" value="ชั่วโมงที่ขาดจากหนึ่งวันในการทดสอบแบตเตอรี่_h"/>
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:FloatPropertyValue"
