              appliedPropertyValueGroups="#bb00b743-8afb-404f-9a20-abcf719aa116">
            <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
                id="004cb78b-89c0-45a0-ac5f-4095371bcfd3" name="ชั่วโมงที่ขาดจากหนึ่งวันในการทดสอบแบตเตอรี่_h"
                description="เวลา. MOP สำหรับคำถาม PA: การทดสอบแบตเตอรี่ของโครงงานเสาทำงาน 1,000 นาทีจากชาร์จเต็ม อ่านค่าทุก 10 นาที (P2 ตารางที่ 4-1) เทียบกับ 24 ชั่วโมงของ SR5 ของวิทยานิพนธ์. แดงตามที่เขียนไว้: การทดสอบที่บันทึกไว้จบลงขาดจากหนึ่งวัน 7.33 ชั่วโมง โครงงานเสารายงานว่า 16 ชั่วโมง (P2 หัวข้อ 4.2). หมวดการศึกษา: REV-OBJ-3_ความน่าเชื่อถือของระบบ"
                appliedPropertyValueGroups="#0807c5e3-c935-4af6-86b8-88d30a882a03"
                constrainedElements="#522edacb-c135-44c9-8114-f7389b4ff780">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="0807c5e3-c935-4af6-86b8-88d30a882a03" name="NORASI.Constraint">
