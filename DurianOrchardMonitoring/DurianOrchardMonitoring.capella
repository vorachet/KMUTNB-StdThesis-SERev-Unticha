                appliedPropertyValueGroups="#b69719b4-d287-4ebb-812c-a10bc49cb6f3"
                constrainedElements="#e7765e9d-2d80-415d-9973-35af2d4738f5">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
