            <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
                id="52ecbf1f-4f39-44f4-acb1-ea5c08296157" name="สัดส่วนค่าวัดที่ส่งถึงที่ระยะ_400_m_pct"
                description="คุณภาพ. MOP สำหรับคำถาม SA: ระบบส่งค่าวัดข้ามสวนได้ 400 เมตร โดยถึงอย่างน้อยร้อยละ 96 หรือไม่? แถบเกณฑ์คือ SR1 ของวิทยานิพนธ์ (วิทยานิพนธ์ หัวข้อ 3.6.2) ซึ่งวิทยานิพนธ์ระบุว่าร้อยละ 96 กู้คืนมาจากผลที่วัดได้ ไม่ได้ตั้งไว้ก่อนการทดสอบ ค่านี้คืออัตราการส่งถึงที่โครงงาน GUI รายงานที่ระยะ 400 เมตร (GUI หัวข้อ 4.1). หมวดการศึกษา: REV-OBJ-1_ประสิทธิภาพการทำงาน"
                appliedPropertyValueGroups="#f4343f39-ac6d-45d1-80d3-44e2fee87700"
                constrainedElements="#5a7f49ea-4694-485f-9424-fee9dab9e855">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="f4343f39-ac6d-45d1-80d3-44e2fee87700" name="NORASI.Constraint">
