          <ownedFunctionalChains xsi:type="org.polarsys.capella.core.data.fa:FunctionalChain"
              id="7ab7ac77-29c8-4528-8f5e-1f4b6331ecbb" name="SR-04_จ่ายพลังงานให้ตัวเองทั้งกลางวันและกลางคืน"
              appliedPropertyValueGroups="#0809aeba-f6f4-4d19-9ec5-33eee5985359">
            <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
                id="7fc1393e-ee3c-47aa-815b-e926219e973a" name="ชั่วโมงที่ขาดจากหนึ่งวันของแบตเตอรี่_h"
                description="เวลา. MOP สำหรับคำถาม SA: เมื่อสถานีทำงานด้วยแบตเตอรี่จากชาร์จเต็ม ขาดจากหนึ่งวันไปกี่ชั่วโมง? SR5 ของวิทยานิพนธ์ต้องการให้บันทึกตลอดเวลา 24 ชั่วโมงต่อวัน (วิทยานิพนธ์ หัวข้อ 3.6.2; ประเด็น F-06) การขาดเท่าใดก็ตามจึงไม่ผ่าน ค่านี้ใช้ 16 ชั่วโมงที่โครงงานเสารายงานสำหรับแบตเตอรี่ (P2 หัวข้อ 4.2). แดงตามที่เขียนไว้: 16 ชั่วโมงจากชาร์จเต็มขาดจากหนึ่งวัน 8 ชั่วโมง (ประเด็น F-06). หมวดการศึกษา: REV-OBJ-3_ความน่าเชื่อถือของระบบ"
                appliedPropertyValueGroups="#bf0e3266-e2c1-4772-98fb-b377f2250e5d"
                constrainedElements="#7ab7ac77-29c8-4528-8f5e-1f4b6331ecbb">
