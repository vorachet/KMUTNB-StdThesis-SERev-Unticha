          <ownedFunctionalChains xsi:type="org.polarsys.capella.core.data.fa:FunctionalChain"
              id="976ce0ea-65a8-49d2-b52c-eada062b0f57" name="DP-02_เสาอากาศ_5_dBi_ทั้งสองฝั่ง"
              appliedPropertyValueGroups="#0c5d605e-5960-499c-bf68-76d13a8ff62f">
            <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
                id="643d400f-a2de-4118-b9e1-707d71de46f4" name="กำลังที่รับได้ที่ระยะ_400_m_dBm"
                description="คุณภาพ. MOP สำหรับคำถาม LA: งบการเชื่อมโยงที่ 400 เมตรรักษากำลังที่รับได้ให้สูงกว่าความไว -130 dBm ที่โครงงาน GUI อ้างไว้หรือไม่ (GUI หัวข้อ 3.4)? ขอบบนของแถบเกณฑ์ 27 dBm คือกำลังส่งรวมอัตราขยายของเสาอากาศทั้งสอง 17 + 5 + 5 ซึ่งเป็นค่ามากที่สุดที่ตัวรับจะได้ เมื่อนับอัตราขยายแต่ละตัวเพียงครั้งเดียว งบได้ -50.6 dBm ส่วนโครงงาน GUI หักอัตราขยายทั้งสองออกจากการสูญเสียตามเส้นทางอีกครั้ง และพิมพ์ -40.8 dBm (GUI หัวข้อ 3.4). หมวดการศึกษา: REV-OBJ-1_ประสิทธิภาพการทำงาน"
                appliedPropertyValueGroups="#2ef9599f-989d-4c8a-8a60-ba421c9779b5"
                constrainedElements="#976ce0ea-65a8-49d2-b52c-eada062b0f57 #72c4f4fb-de18-49d9-9310-8e52688b36ec">
              <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                  id="2ef9599f-989d-4c8a-8a60-ba421c9779b5" name="NORASI.Constraint">
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue"
                    id="5b78bc4c-97c8-47cd-bd79-524c498775ae" name="name" value="กำลังที่รับได้ที่ระยะ_400_m_dBm"/>
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:FloatPropertyValue"
                    id="e21a551b-8c1a-43e3-8526-dd7c0b235a0c" name="min" value="-130.0"/>
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:FloatPropertyValue"
                    id="2bdd67dc-13cd-492a-b25d-86f560a39583" name="max" value="27.0"/>
                <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:EnumerationPropertyValue"
