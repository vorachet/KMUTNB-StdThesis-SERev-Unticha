              appliedPropertyValueGroups="#76d68439-b91c-43d7-a061-1c9370d31f7e">
            <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
                id="94a1bbe6-4690-4d27-b5c6-bc82774f3894" name="สภาพพร้อมใช้ของเซิร์ฟเวอร์_CasaOS_pct"
                description="คุณภาพ. MOP สำหรับคำถาม PA: จำนวนวันที่เซิร์ฟเวอร์ CasaOS ทำงานในบันทึกของโครงงาน GUI 30 พฤศจิกายน 2024 ถึง 13 มีนาคม 2025 (GUIS สไลด์ 34-35) เทียบกับ SR5 ของวิทยานิพนธ์ ตลอดเวลา. แดงตามที่เขียนไว้: เซิร์ฟเวอร์ล่ม 5 วันจาก 105 วัน โครงงาน GUI ระบุว่าเซิร์ฟเวอร์ล่มเป็นปัญหาและเสนอเซิร์ฟเวอร์ของอาคาร Techno Park (GUIS สไลด์ 138). หมวดการศึกษา: REV-OBJ-3_ความน่าเชื่อถือของระบบ"
                appliedPropertyValueGroups="#0f8966e7-5bc3-49e8-b8c5-d71ab7d9dae8"
                constrainedElements="#b1d08f8a-a8d5-493d-9e39-56117b19cea4">
