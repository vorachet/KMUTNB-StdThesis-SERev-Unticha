              <ownedPhysicalComponents xsi:type="org.polarsys.capella.core.data.pa:PhysicalComponent"
                  id="c3fcdc1d-6f64-4411-baaf-fac8f5cfddcc" appliedPropertyValueGroups="#ce579613-62ba-4f35-9384-e50ccc20b0e0 #3d0a67e3-335c-4c26-939b-dda0c0370258"
                  name="บอร์ด_ESP32S_ของเสา" kind="HARDWARE_COMPUTER" nature="NODE">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="ce579613-62ba-4f35-9384-e50ccc20b0e0" name="NORASI.Solution">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue"
                      id="4ca9ab70-d955-4c4f-843c-badfc7f3d069" name="technology"
                      value="ESP32-S บนบอร์ดฐาน เสาละหนึ่งตัว (P2 หัวข้อ 3.3) สัญญาณนาฬิกาสูงสุด 240 MHz (GUI ตารางที่ 2-3) ไฟ 5 V จาก AMS1117 (วิทยานิพนธ์ ตารางที่ 10); ทำงาน โมดูลอ่านเซ็นเซอร์ของเสา, โมดูลจัดการพลังงานของเสา และ โมดูลส่ง_LoRa_ของเสา; ตามที่สร้างจริงส่งเฟรมทุก 200 ms และไม่เข้าโหมดหลับ (รายการโปรแกรมของ P2) คือการตัดสินใจ DP-09_ส่งทุก_200_ms_ไม่หลับเลย ซึ่งผู้ออกแบบเดิมไม่ได้ระบุเหตุผล"/>
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue"
                      id="bbe69d8e-1285-4841-b61b-f3c9cd0d3523" name="build" value="ซื้อ -- ESP32 ราคา 200 บาทต่อบอร์ด อยู่ในรายการจัดซื้อของโครงงานเสา (P2 ภาคผนวก ค)"/>
                </ownedPropertyValueGroups>
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="3d0a67e3-335c-4c26-939b-dda0c0370258" name="NORASI.Part">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:IntegerPropertyValue"
                      id="8198b3ea-ba9f-4b50-a2d8-d2e693946494" name="จำนวน" value="1"/>
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:IntegerPropertyValue"
                      id="9dfb97de-cfa4-4af8-8dce-f234607f74cd" name="ราคาต่อหน่วย"
                      value="200"/>
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:IntegerPropertyValue"
                      id="57741a04-9678-4084-a9cb-a02ed619a8a6" name="แรงดันจ่าย_v"
                      value="5"/>
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:IntegerPropertyValue"
                      id="5095d7a6-7059-4a9e-8b9e-b802f881d135" name="ความถี่ซีพียู_mhz"
                      value="240"/>
                </ownedPropertyValueGroups>
