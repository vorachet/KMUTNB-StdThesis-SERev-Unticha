                  name="คอมพิวเตอร์เซิร์ฟเวอร์ในสวน" kind="HARDWARE_COMPUTER" nature="NODE">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="b37dc5d9-cd7f-44db-bc31-53936f7566e4" name="NORASI.Solution">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue"
                      id="3ed6672d-7258-4491-8f84-2791cc06fcb3" name="technology"
                      value="เซิร์ฟเวอร์ในพื้นที่ที่ใช้ CasaOS (วิทยานิพนธ์ ตารางที่ 12); บันทึกของเซิร์ฟเวอร์ครอบคลุม 105 วันตั้งแต่ 30 พฤศจิกายน 2024 ถึง 13 มีนาคม 2025 โดยเซิร์ฟเวอร์ล่ม 5 วัน (GUIS สไลด์ 34-35); โครงงาน GUI เสนอให้ใช้เซิร์ฟเวอร์ของอาคาร Techno Park แทน (GUIS สไลด์ 138); ทำงาน โฟลว์ข้อมูล_Node_RED, โฟลว์แจ้งเตือน_Node_RED, คลังข้อมูล_InfluxDB และ เว็บแอป_MyDurian; เลือกไว้ใน DP-16_เซิร์ฟเวอร์_CasaOS_ในสวนแทน_AWS แทนการโฮสต์บน AWS Amplify ในระยะแรก (วิทยานิพนธ์ ตารางที่ 12)"/>
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue"
                      id="26b1911e-61d0-4492-be8e-be7d56aa66fc" name="build" value="ซื้อ -- ไม่อยู่ในรายการจัดซื้อของโครงงานใดเลย: โครงงานไม่ได้ใช้เงินกับเครื่องนี้"/>
                </ownedPropertyValueGroups>
