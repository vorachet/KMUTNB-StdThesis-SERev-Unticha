              <ownedFeatures xsi:type="org.polarsys.capella.core.data.cs:Part" id="6041737f-d8a6-434d-a065-11ea62b33bae"
                  name="รายการจัดซื้อของโครงงาน_GUI" abstractType="#6ff47064-dfa0-4d3e-91dc-3bc6fc3fa2dc"/>
              <ownedPhysicalComponents xsi:type="org.polarsys.capella.core.data.pa:PhysicalComponent"
                  id="d1f7af92-049f-4f0d-a801-97cf3bc45f41" appliedPropertyValueGroups="#c8beedd5-c97a-4ec5-a15a-21b4c9fb9ebc #fb33ba5f-ba8b-454d-ab8f-2413b9ba342f"
                  name="รายการจัดซื้อของโครงงานเสา" kind="HARDWARE" nature="NODE">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="c8beedd5-c97a-4ec5-a15a-21b4c9fb9ebc" name="NORASI.Solution">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue"
                      id="6caa3d3a-6e90-4d79-bcb8-57934bf96642" name="technology"
                      value="รายการ 44 บรรทัดที่โครงงานเสาซื้อมาเพื่อสร้างและทดสอบต้นแบบ ตามภาคผนวกงบประมาณ (Tuntawisut et al., 2024 ภาคผนวก ค); ราคาต่อชิ้นคูณจำนวนรวมได้ 157,362 บาท ขณะที่ภาคผนวกระบุยอดรวม 156,858 และราคารวมแต่ละบรรทัดที่พิมพ์ไว้รวมได้ 157,762; วิทยานิพนธ์เรียก 156,858 ว่างบประมาณของสองโครงการ (ตารางที่ 26)"/>
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue"
                      id="8bbecc14-9871-4440-bbf4-2e2f082ecbd6" name="build" value="โครงงานเสาซื้อมาเพื่อสร้างและทดสอบต้นแบบ"/>
                </ownedPropertyValueGroups>
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="fb33ba5f-ba8b-454d-ab8f-2413b9ba342f" name="NORASI.Part">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:IntegerPropertyValue"
                      id="62fd2b93-b893-4215-96c3-adf225c026fa" name="จำนวน" value="1"/>
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:IntegerPropertyValue"
                      id="eab02485-7003-4a0d-b7e8-3c07441108da" name="ราคาต่อหน่วย"/>
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:IntegerPropertyValue"
                      id="06774058-a78f-463c-8558-5306fc67e08b" name="จำนวนบรรทัด"
                      value="44"/>
                </ownedPropertyValueGroups>
              </ownedPhysicalComponents>
              <ownedPhysicalComponents xsi:type="org.polarsys.capella.core.data.pa:PhysicalComponent"
                  id="6ff47064-dfa0-4d3e-91dc-3bc6fc3fa2dc" appliedPropertyValueGroups="#36ebf39f-726d-4330-a19c-415af82b162e #4c1ababe-5f4b-4207-a24a-245c661e8060"
                  name="รายการจัดซื้อของโครงงาน_GUI" kind="HARDWARE" nature="NODE">
                <ownedPropertyValueGroups xsi:type="org.polarsys.capella.core.data.capellacore:PropertyValueGroup"
                    id="36ebf39f-726d-4330-a19c-415af82b162e" name="NORASI.Solution">
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue"
                      id="532e0653-7191-4513-99d7-b53dffb44136" name="technology"
                      value="14 บรรทัดที่โครงงาน GUI ซื้อสำหรับเกตเวย์ วิทยุ และกล่อง ตามที่สไลด์สอบป้องกันระบุไว้ (GUIS สไลด์ 139); ราคาต่อหน่วยคูณจำนวนรวมได้ 21,420 บาท เท่ากับยอดรวมที่สไลด์พิมพ์ไว้"/>
                  <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue"
                      id="3811731c-eb11-453d-83fe-d88decc807d2" name="build" value="โครงงาน GUI ซื้อมาเพื่อสร้างและทดสอบต้นแบบ"/>
                </ownedPropertyValueGroups>
